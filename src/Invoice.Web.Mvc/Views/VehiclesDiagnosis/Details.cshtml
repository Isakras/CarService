@using Abp.Application.Services.Dto;
@using Abp.Notifications;
@using Abp.Localization;

@using Invoice.VehiclesDiagnosis.Dto;

@model VehicleDiagnosisDto

@{
    ViewData["Title"] = "Diagnosis Details";
}
<style>
    .with-vertical-line {
        display: flex;
        align-items: center;
        border-left: 1px solid #00997b; /* Bootstrap's secondary color #6c757d */
        padding-left: 10px;
        min-height: 30px;
    }
</style>
@section Scripts {
    <script>
        function openPrintWindow() {
            const url = '@Url.Action("PrintInvoice", "VehiclesDiagnosis", new { id = Model.Id })';
            window.open(url, '_blank');
        }
    </script>
}

@Html.ValidationSummary(true, "", new { @class = "text-danger" })


<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Detajet e Kontrolles</h1>
            </div>
        </div>
    </div>
</section>


<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-9">
                <div class="card">
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">Emri Klientit:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line"> @Model.ClientName </div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Data e Kontrolles:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.DiagnosisDate.ToString("yyyy-MM-dd")</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Shasia:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.Vehicle?.VIN</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Marka:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.Vehicle?.Make</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Modeli:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.Vehicle?.Model</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Tabelat:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.PlateNo</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Prshkimi i Problemit:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.ProblemDescription</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Pershkrimi i Rregullimit:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.FixDescription</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Cmimi:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line"> @Model.Cost.ToString("N2") € </div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Pagesa:</dt>
                            <dd class="col-sm-9">
                                @if (Model.IsPayed)
                                {
                                    <div class="with-vertical-line text-success font-weight-bold">
                                        Paguar  - 
                                        <span class="d-block"> Date :(@Model.PaymentDate?.ToString("dd/MM/yyyy"))</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="with-vertical-line text-danger font-weight-bold">
                                        Pa paguar
                                    </div>
                                }
                            </dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Komenti:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.Comments</div></dd>
                            <hr class="w-100 my-1" />

                            <dt class="col-sm-3">Mekaniku:</dt>
                            <dd class="col-sm-9"><div class="with-vertical-line">@Model.Mechanic?.FullName</div></dd>
                        </dl>
                    </div>
                    </div>
               @*  <div class="card"> *@
                   @*  <div class="card-body"> *@
                        @if (!Model.IsPayed)
                        {
                            <form asp-action="UpdatePayment" method="post">
                                <input type="hidden" name="Id" value="@Model.Id" />

                                <div class="row justify-content-md-start">
                                    <div class="col-md-3">
                                        <!-- 1/4 width -->
                                        <div class="card mt-3 border-danger">
                                            <div class="card-header bg-gradient-danger text-white text-center">
                                                Konfirmo Pagesën!
                                            </div>
                                            <div class="card-body">
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" name="MarkAsPayed" value="true" id="markAsPayedCheckbox" />
                                                 <label class="form-check-label" for="markAsPayedCheckbox"> <b>Paguar</b></label>
                                                </div>

                                                <div class="mb-4"> 
                                                    <label for="SelectedPaymentDate" class="form-label">Data e Pagesës</label>
                                                <input type="date" class="form-control" name="SelectedPaymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                                </div>

                                                <button type="submit" class="btn btn-success w-100">Ruaj</button>
                                        </div>
                                </div>
                            </div>
                                </div>
                            </form>
                        }
                 @*    </div> *@
               @*  </div> *@

           
                <a asp-action="Index" class="btn btn-flat btn-info mt-3"> << Kthehu Tek Lista</a>
            </div>
            <div class="mb-3">
                <button class="btn btn-primary" onclick="openPrintWindow()">Printo</button>
            </div>
        </div>
    </div>
</section>



