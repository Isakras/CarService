<body onload="handlePrint()">

<div id="invoice">
        <!-- 🔷 Logo on Top -->
        <div class="text-center" style="background-color:#bcbfc0 ">
            <img src="~/img/LogoMeritoniMercedes.png" alt="Meritoni Logo" style="max-height: 220px;">
        </div>
        <br />
        <br/>

        <!-- 🔷 Invoice Header -->
 <div class="invoice overflow-auto">
            <header class="invoice-header row align-items-start">
              @*   <div class="row"> *@
  
                <div class="col-6   text-left">
                    <h2>D.P.Z "MERITONI"</h2>
                    <p><strong>Emri i Biznesit:</strong> Meriton Krasniqi B.I</p>
                    <p><strong>UNI:</strong> 810739310</p>
                    <p><strong>Telefoni:</strong> +383 44 352-525</p>
                    <p><strong>Adresa:</strong> Krushe e Madhe, Rahovec</p>
                </div>


                <div class=" col-6  text-right ">
                    <div >
                        <h2>Klienti Detajet</h2>
                        <div style="display: inline-block; text-align: right;">
                            <table class="table table-sm table-borderless mb-0">
                      
                            <tbody>
                                <tr>
                                    <th scope="row" class="text-right">Emri i Klientit:</th>
                                    <td class="text-left">@Model.ClientName</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-right">Telefon:</th>
                                    <td class="text-left">@Model.PhoneNumber</td>
                                </tr>
                               @*  <tr>
                                    <th scope="row" class="text-right">Shasia:</th>
                                    <td class="text-left">@Model.Vehicle?.VIN</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-right">Targat:</th>
                                    <td class="text-left">@Model.PlateNo</td>
                                </tr> *@
                                <tr>
                                    <th scope="row" class="text-right">Data:</th>
                                    <td class="text-left">@Model.DiagnosisDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-right">NrFatures#:</th>
                                    <td class="text-left">@Model.Id</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
             </div>

            </header>

    <main>
                <hr class="my-4" style="border: 1px solid #007bff;" />

                <!-- Styled Table -->
                <table class="table table-bordered mb-2 thead-dark">
                    <thead style="background-color: cadetblue; font-weight: bold;" class="text-center">
                        <tr>
                            <th style="width: 40px;">Nr</th>
                            <th style="width: 300px;">Pershkrimi</th>
                            <th style="width: 120px;">Shasia</th>
                            <th style="width: 120px;">Modeli</th>
                       @*      <th style="width: 180px;">Komenti</th> *@
                            <th style="width: 100px;">Cmimi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="width: 40px; word-break: break-word; white-space: normal;">1</td>
                            <td class="text-center" style="width: 300px; word-break: break-word; white-space: normal;">@Model.FixDescription</td>
                            <td class="text-center" style="width: 180px; word-break: break-word; white-space: normal;">@Model.Vehicle.VIN</td>
                            <td class="text-center" style="width: 140px; word-break: break-word; white-space: normal;">@Model.Vehicle.Make @Model.Vehicle.Model</td>
         @*                    <td class="text-center" style="width: 180px; word-break: break-word; white-space: normal;">@Model.Comments</td> *@
                            <td class="text-right" style="width: 100px; word-break: break-word; white-space: normal;">@Model.Cost.ToString("N2") €</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-right font-weight-bold">
                                @(Model.IsPayed ? "Paguar" : "Pa Paguar")
                            </td>
                            <td class="text-right font-weight-bold">
                                @Model.Cost.ToString("N2") €
                            </td>
                        </tr>
                    </tfoot>
                </table>
                <br />
                <br />
                <!-- 🔽 Signatures -->
                <div class="row mt-5">
                    <div class="col-6 text-left">
                        <p><strong>D.P.Z "MERITONI"</strong></p>
                        <p style="margin-bottom: 1px;">_________________________</p>
                        <p style="margin-top: 1px;"><small>Nënshkrimi</small></p>
                    </div>
                    <div class="col-6 text-right">
                        <p style="padding-right: 110px;"><strong>Klienti:</strong></p>
                      
                         <p style="margin-bottom: 1px;">_________________________</p>
                         <p style="margin-top: 1px;"><small>Nënshkrimi</small></p>
                    
                    </div>
                </div>
                <br /><br />
                <hr class="my-3" style="border: 1px dotted" />
      <div class="text-center mt-5">
        <p>Faleminderit qe keni zgjedhur sherbimet tona</p>
         <p>Krushe e Madhe; Date: @DateTime.Today.ToString("yyyy-MM-dd");</p>
         </div>
    </main>
  </div>
</div>

<script>
  function handlePrint() {
    window.print();
    window.onafterprint = function() {
            window.location.href = '@Url.Action("Details", "VehiclesDiagnosis", new { id = Model.Id })';
    };
  }
</script>
               
</body>
</html>


