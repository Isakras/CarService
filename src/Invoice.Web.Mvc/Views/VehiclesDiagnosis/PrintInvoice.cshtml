@using Abp.Application.Services.Dto;
@using Abp.Notifications;
@using Abp.Localization;
@using Invoice.VehiclesDiagnosis.Dto;
@model VehicleDiagnosisDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Invoice #@Model.Id</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">


   <style>


        thead {
            /* background-color: brown !important; */
            -webkit-print-color-adjust: exact; /* Chrome, Safari */
            print-color-adjust: exact; /* Firefox */
            font-weight: bold;
        }

        @@media print {
            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            html, body {
                background: white !important;
                color: black !important;
                margin: 0;
                padding: 0;
            }

            .print-footer {
                position: fixed;
                bottom: 20px;
                left: 0;
                right: 0;
                font-size: 14px;
                color: #000;
                background: white;
                padding-top: 10px;
                padding-bottom: 10px;
                border-top: 1px dotted #999;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
     
    }
</style>


</head>

<body onload="handlePrint()">

<div id="invoice">
        <!-- 🔷 Logo on Top -->
        <div class="text-center" style="background-color:#bcbfc0 ">
            <img src="~/img/LogoMeritoniMercedes.png" alt="Meritoni Logo" style="max-height: 220px;">
        </div>
        <br />
        <br/>

        <!-- 🔷 Invoice Header -->
 <div class="invoice"> 
             <header class="invoice-header row align-items-start">
                <div class="col-6   text-left">
                    <h2>D.P.Z "MERITONI"</h2>
                    <p><strong>Emri i Biznesit:</strong> Meriton Krasniqi B.I</p>
                    <p><strong>UNI:</strong> 810739310</p>
                    <p><strong>Telefoni:</strong> +383 44 352-525</p>
                    <p><strong>Adresa:</strong> Krushe e Madhe, Rahovec</p>
                </div>


                <div class=" col-6  text-right ">
                    <div >
                        <h2>Detajet e Klientit</h2>
                        <div style="display: inline-block; text-align: right;">
                            <table class="table table-sm table-borderless mb-0">
                      
                            <tbody>
                                <tr>
                                    <th scope="row" class="text-right">Emri i Klientit:</th>
                                    <td class="text-left">@Model.ClientName</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-right">Shasia:</th>
                                    <td class="text-left">@Model.Vehicle.VIN</td>
                                </tr>
                                                           <tr>
                                    <th scope="row" class="text-right">Data:</th>
                                    <td class="text-left">@Model.DiagnosisDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-right">NrFatures#:</th>
                                    <td class="text-left">@Model.Id</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
             </div>

            </header> 

    <main>
                 <hr class="my-4" style="border: 1px solid #007bff;" /> 

                <!-- Styled Table -->
                <!-- Styled Articles Table -->
                <table class="table table-bordered" style=" width:100%; table-layout:fixed;">
                    <thead style="background-color: cadetblue; font-weight: bold;" class="text-center">
                        <tr>
                            <th style="width: 5%;">Nr</th>
                            <th style="width: 45%;">Pershkrimi</th>
                            <th style="width: 15%;">Sasia</th>
                            <th style="width: 17%;">Çmimi</th>
                            <th style="width: 18%;">Totali</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Articles != null && Model.Articles.Any())
                        {
                            var index = 1;
                            foreach (var article in Model.Articles)
                            {
                                <tr>
                                    <td class="text-center">@index</td>
                                    <td>@article.Name</td>
                                    <td class="text-center">@article.Quantity</td>
                                    <td class="text-right">@article.Price.ToString("N2") €</td>
                                    <td class="text-right">@((article.Quantity * article.Price).ToString("N2")) €</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Nuk ka artikuj të regjistruar.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-right font-weight-bold">Totali:</td>
                            <td class="text-right font-weight-bold text-success">
                                @Model.Articles?.Sum(a => a.Quantity * a.Price).ToString("N2") €
                            </td>
                        </tr>
                    @*     <tr>
                            <td colspan="4" class="text-right font-weight-bold">Statusi i Pagesës:</td>
                            <td class="text-right font-weight-bold">
                                @(Model.IsPayed ? "Paguar" : "Pa Paguar")
                            </td>
                        </tr> *@
                    </tfoot>
                </table>
                <br />
                <br />
         
                <!-- 🔽 Signatures -->
                <div class="row mt-5">
                    <div class="col-6 text-left">
                        <p><strong>D.P.Z "MERITONI"</strong></p>
                        <p style="margin-bottom: 1px;">_________________________</p>
                        <p style="margin-top: 1px;"><small>Nënshkrimi</small></p>
                    </div>
                    <div class="col-6 text-right">
                        <p style="padding-right: 110px;"><strong>Klienti:</strong></p>
                      
                         <p style="margin-bottom: 1px;">_________________________</p>
                         <p style="margin-top: 1px;"><small>Nënshkrimi</small></p>
                    
                    </div>
                </div>
                <br /><br />
      
    </main>
            <footer class="print-footer text-center">
                <hr class="my-3" style="border: 2px medium" />
                <p>Faleminderit që keni zgjedhur shërbimet tona</p>
                <p>Krushe e Madhe; Date: @DateTime.Today.ToString("yyyy-MM-dd")</p>
            </footer>
  </div>
</div>
 

<script>
  function handlePrint() {
    window.print();
    window.onafterprint = function() {
            window.location.href = '@Url.Action("Details", "VehiclesDiagnosis", new { id = Model.Id })';
    };
  }
</script>
               
</body>
</html>


