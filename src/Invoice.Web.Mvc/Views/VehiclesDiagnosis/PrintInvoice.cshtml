@using Abp.Application.Services.Dto;
@using Abp.Notifications;
@using Abp.Localization;

@using Invoice.VehiclesDiagnosis.Dto;

@model VehicleDiagnosisDto


<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Invoice #@Model.Id</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @@media print {
      .no-print {
        display: none;
      }
    }
    #invoice {
      padding: 30px;
    }
    .invoice-header {
      margin-bottom: 30px;
      border-bottom: 2px solid #3989c6;
      padding-bottom: 10px;
    }
    .company-details {
      text-align: right;
    }
    .invoice-details {
      text-align: right;
      color: #3989c6;
    }
  </style>
</head>
<body onload="handlePrint()">
<div id="invoice">
  <div class="toolbar mb-3 no-print text-right">
    <button onclick="window.print()" class="btn btn-info">
      <i class="fa fa-print"></i> Print
    </button>
  </div>
  <div class="invoice overflow-auto">
    <header class="invoice-header row">
                <div class="col-6 order-2 text-right border-left pl-4">
                    <h4>Client Information</h4>
                    <div class="d-flex justify-content-end">
                        <table class="table table-borderless table-sm w-auto">
                            <tbody>
                                <tr>
                                    <th class="text-left ">Name:</th>
                                    <td class="text-left">@Model.ClientName</td>
                                </tr>
                                <tr>
                                    <th class="text-left ">Plate No:</th>
                                    <td class="text-left">@Model.Vehicle?.PlateNo</td>
                                </tr>
                                <tr>
                                    <th class="text-left ">VIN:</th>
                                    <td class="text-left">@Model.Vehicle?.VIN</td>
                                </tr>
                                <tr>
                                    <th class="text-left ">Date:</th>
                                    <td class="text-left">@Model.DiagnosisDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                                <tr>
                                    <th class="text-left ">Invoice #:</th>
                                    <td class="text-left">@Model.Id</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-6 order-1 text-left">
                    <h2>Your Car Service</h2>
                    <p><strong>ID:</strong> 123456</p>
                    <p><strong>Name:</strong> AutoTech Service</p>
                    <p><strong>Phone:</strong> +383 49 111 222</p>
                    <p><strong>Address:</strong> Rr. Bulevardi Bill Klinton, Prishtinë</p>
                </div>
              
    </header>

    <main>
      <table class="table table-bordered w-100">
        <thead class="thead-light">
          <tr>
            <th>Description</th>
            <th class="text-left">Detail</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Problem Description</td>
            <td class="text-left">@Model.ProblemDescription</td>
          </tr>
          <tr>
            <td>Fix Description</td>
                            <td class="text-left">@Model.FixDescription</td>
          </tr>
          <tr>
            <td>Mechanic</td>
                            <td class="text-left">@Model.Mechanic?.FullName</td>
          </tr>
          <tr>
            <td>Cost</td>
                            <td class="text-left">@Model.Cost.ToString("N2") €</td>
          </tr>
          <tr>
            <td>Payment Status</td>
                            <td class="text-left">
              @if (Model.IsPayed) {
                <span class="text-success">Paid on @Model.PaymentDate?.ToString("dd/MM/yyyy")</span>
              } else {
                <span class="text-danger">Not Paid</span>
              }
            </td>
          </tr>
          <tr>
            <td>Comments</td>
            <td class="text-right">@Model.Comments</td>
          </tr>
        </tbody>
      </table>
      <div class="text-center mt-5">
        <p>Thank you for choosing our service!</p>
      </div>
    </main>
  </div>
</div>

<script>
  function handlePrint() {
    window.print();
    window.onafterprint = function() {
            window.location.href = '@Url.Action("Details", "VehiclesDiagnosis", new { id = Model.Id })';
    };
  }
</script>
</body>
</html>

