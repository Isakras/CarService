@model Invoice.VehiclesDiagnosis.Dto.CreateVehicleDiagnosisDto
@{
    ViewBag.Title = "Create Vehicle Diagnosis";
}

@section scripts
{
    <script src="~/view-resources/Views/VehiclesDiagnosis/Create.js" asp-append-version="true"></script>

    <script>
        let articleIndex = 1;

        function recalculateTotals() {
             let grandTotal = 0;
            $('#articlesBody tr').each(function () {
                const quantity = parseFloat($(this).find('.quantity').val()) || 0;
                const price = parseFloat($(this).find('.price').val()) || 0;
                const total = quantity * price;
                $(this).find('.total').val(total.toFixed(2));

                grandTotal += total;
                
            });

            $('#Cost').val(grandTotal.toFixed(2));
        }

        $(document).on('input', '.quantity, .price', function () {
            recalculateTotals();
        });

        $(document).on('click', '.add-article', function () {
            const newRow = `
                <tr>
                    <td><input name="Articles[${articleIndex}].Name" class="form-control" /></td>
                    <td><input name="Articles[${articleIndex}].Quantity" type="number" class="form-control quantity" min="1" value="1" /></td>
                    <td><input name="Articles[${articleIndex}].Price" type="number" class="form-control price" step="0.01" min="0" value="0.00" /></td>
                    <td><input name="Articles[${articleIndex}].Total" type="number" class="form-control total" readonly /></td>
                    <td><button type="button" class="btn btn-danger remove-article"><i class="fa fa-trash"></i></button></td>
                </tr>`;
            $('#articlesBody').append(newRow);
            articleIndex++;
        });

        $(document).on('click', '.remove-article', function () {
            $(this).closest('tr').remove();
            recalculateTotals();
        });

        // Initial total calculation
        $(document).ready(function () {
            recalculateTotals();
        });
    </script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Create New Diagnose")</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <form asp-action="Create" method="post" form-control-border>
                        <div class="card-body">
 
                            <!-- 🚗 Vehicle Info Section -->
                            <h5 class="mb-3"> <b>@L("Vehicle Information") </b></h5>
                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label for="vinInput">Shasia</label>
                                    <div class="input-group">
                                        <input type="text" id="vinInput" class="form-control" placeholder="Enter VIN" />
                                        <div class="input-group-append">
                                            <button type="button" id="searchVinBtn" class="btn btn-info">Kerko me Shasi</button>
                                        </div>
                                    </div>
                                    <small class="text-muted" id="vinStatus"></small>
                                </div>
                                </div>
                                <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label>Modeli</label>
                                    <input type="text" id="markInput" class="form-control" disabled />
                                </div>
                                <div class="form-group col-md-4">
                                    <label>Marka</label>
                                    <input type="text" id="modelInput" class="form-control" disabled />
                                </div>
                               <div class="form-group col-md-4">
                                    <label>Tabelat</label>
                                 @*    <input type="text" id="plateNoInput" class="form-control" /> *@
                                  <input asp-for="PlateNo" id="plateNoInput" class="form-control" />
                                <span asp-validation-for="PlateNo" class="text-danger"></span>
                                </div> 
                               
                                <div class="form-group col-md-4">
                                 @*    <label asp-for="VehicleId"></label> *@
                                    <input asp-for="VehicleId" class="form-control" hidden />
                                    <span asp-validation-for="VehicleId" class="text-danger"></span>
                                </div>
 
                            </div>
                          
                            <hr class="my-4" />
                  
  
                            <!-- 👤 Client Info -->
                            <h5 class="mt-4 mb-3"> <b>@L("Diagnosis Details")</b></h5>
                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label asp-for="ClientName">Emri Klientit</label>
                                    <input asp-for="ClientName" class="form-control"  required/>
                                    <span asp-validation-for="ClientName" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <label asp-for="PhoneNumber">Nr Telefonit</label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <label asp-for="DiagnosisDate">Data</label>
                                    <input asp-for="DiagnosisDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="DiagnosisDate" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <label asp-for="ProblemDescription">Pershkrimi i Defektit</label>
                                    <textarea asp-for="ProblemDescription" class="form-control"></textarea>
                                    <span asp-validation-for="ProblemDescription" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <label asp-for="FixDescription">Pershrkimi i Rregullimit</label>
                                    <textarea asp-for="FixDescription" class="form-control"></textarea>
                                    <span asp-validation-for="FixDescription" class="text-danger"></span>
                                </div>

                                <div class="form-group col-md-4">
                                    <label asp-for="Comments">Komenti</label>
                                    <textarea asp-for="Comments" class="form-control"></textarea>
                                    <span asp-validation-for="Comments" class="text-danger"></span>
                                </div>
                                <hr class="my-4" />

                                <h5 class="mt-4 mb-3"><b>Artikujt</b></h5>
                                <table class="table table-bordered" id="articlesTable">
                                    <thead>
                                        <tr>
                                            <th>Emri Artikullit</th>
                                            <th>Sasia</th>
                                            <th>Çmimi</th>
                                            <th>Totali</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="articlesBody">
                                        <tr>
                                            <td>
                                                <input name="Articles[0].Name" class="form-control" />
                                            </td>
                                            <td>
                                                <input name="Articles[0].Quantity" type="number" class="form-control quantity" min="1" value="1" />
                                            </td>
                                            <td>
                                                <input name="Articles[0].Price" type="number" class="form-control price" step="0.01" min="0" value="0.00" />
                                            </td>
                                            <td>
                                                <input name="Articles[0].Total" type="number" class="form-control total" readonly />
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-success add-article"><i class="fa fa-plus"></i></button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>


                                <div class="form-group col-md-4">
                                    <label asp-for="MechanicId">Mrkaniku</label>
                                    <select asp-for="MechanicId" class="form-control" asp-items="ViewBag.Mechanics">
                                        <option value="">-- Gjedhe Mekanikun --</option>
                                    </select>
                                    <span asp-validation-for="MechanicId" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <label asp-for="Cost">Vlera Totale</label>
                                    <input  asp-for="Cost" class="form-control" />
                                    <span asp-validation-for="Cost" class="text-danger"></span>
                                </div> 
                                <div class="form-group col-md-4">
                                    <div class="form-check mt-4">
                                        <input asp-for="IsPayed" class="form-check-input big-checkbox" checked />
                                        <label asp-for="IsPayed" class="form-check-label"><b>Pagesa e kryer</b></label>
                                    </div>
                                    <span asp-validation-for="IsPayed" class="text-danger"></span>
                                </div>
                                
                               
                               
                            </div>

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">@L("Create")</button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg ">@L("Cancel")</a>
                            </div>

                        </div>
                      </form>
                </div>
            </div>
        </div>
    </div>
</section>
