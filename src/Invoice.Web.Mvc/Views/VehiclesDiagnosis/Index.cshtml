@using Abp.Application.Services.Dto;
@using Invoice.VehiclesDiagnosis.Dto;
@using Invoice.Web.Startup;
@using Invoice.Web.Models.Common;
@using X.PagedList;
@using X.PagedList.Mvc.Core;
@using X.PagedList.Web.Common;
<!-- X.PagedList.IPagedList<Invoice.VehiclesDiagnosis.Dto.VehicleDiagnosisDto>  -->
@model Invoice.Web.Models.VehicleModules.VehicleDiagnosePageList<Invoice.VehiclesDiagnosis.Dto.VehicleDiagnosisDto>//PagedResultDto<VehicleDiagnosisDto>
@{
    ViewBag.Title = L("VehicleDiagnise");
    ViewBag.CurrentPageName = PageNames.VehiclesDiagnosis;
}

    <style>
        #VehicleTable {
            table-layout: fixed;
            width: 100%;
        }

            #VehicleTable th,
            #VehicleTable td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
    </style>
<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("VehicleDiagnise")</h1>
            </div>
            @*    <div class="col-sm-6">
                <a href="javascript:;" data-toggle="modal" data-target="#VehicleCreateModal" class="btn bg-blue float-sm-right">
                    <i class="fa fa-plus-square"></i>
                    @L("Create")
                </a>
            </div> *@
        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-start mb-3">
                            <div class="col-12 col-md-3 mb-2">
                                @*  <div class="col-md-5"> *@
                                <label>&nbsp;</label>
                                <br />
                                <a class="btn btn-primary  text-white border-0 text-uppercase  " href="@Url.Action("Create")">
                                    + Diagnoze e Re
                                </a>
                            </div>
                            <div class="col-12 col-md-9">
                                @await Html.PartialAsync("~/Views/VehiclesDiagnosis/Index.AdvancedSearch.cshtml")
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">

                                <table id="VehicleTable" class="table table-striped table-bordered table-sm text-wrap">
                                    <thead style="background-color: #4ab6be; color: white;">
                                        <tr>
                                            <th style="width: 80px;">@L("Actions")</th>
                                            <th style="width: 130px;">@L("ClientName")</th>
                                            <th style="width: 130px;">@L("DiagnosisDate")</th>
                                            <th style="width: 170px;">@L("ProblemDescription")</th>
                                            <th style="width: 170px;">@L("FixDescription")</th>
                                            <th style="width: 80px;">@L("Cost")</th>
                                            <th style="width: 80px;">@L("Payed")</th>
                                            <th style="width: 150px;">@L("Comments")</th>
                                            <th style="width: 150px;">@L("Vin")</th>
                                            <th style="width: 100px;">@L("PlateNo")</th>
                                            <th style="width: 100px;">@L("Color")</th>
                                            <th style="width: 130px;">@L("WorkerName")</th>
                                           
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in Model.StaticDiagnosePagedList)
                                    {
                                            <tr>
                                                <td>
                                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info">Detajet</a>
                                                </td>
                                                <td title="@item.ClientName">@item.ClientName</td>
                                                <td title="@item.DiagnosisDate.ToString("yyyy-MM-dd")">@item.DiagnosisDate.ToString("yyyy-MM-dd")</td>
                                                <td title="@item.ProblemDescription">@item.ProblemDescription</td>
                                                <td title="@item.FixDescription">@item.FixDescription</td>
                                                <td title="@item.Cost.ToString()">@item.Cost</td>
                                                @if (item.IsPayed)
                                                   {
                                                           <td style="text-align: center;">
                                                               <i class="fas fa-check bg-green px-1 py-1"></i>
                                                           </td>
                                                   }
                                                   else
                                                   {
                                                           <td style="text-align: center;">
                                                               <i class="fas fa-times bg-red px-2 py-1"></i>
                                                           </td>
                                                   }
                                                <td title="@item.Comments">@item.Comments</td>
                                                <td title="@item.Vehicle.VIN">@item.Vehicle.VIN</td>
                                                <td title="@item.Vehicle.PlateNo">@item.Vehicle.PlateNo</td>
                                                <td title="@item.Vehicle.Color">@item.Vehicle.Color</td>
                                                <td title="@item.Mechanic.FullName">@item.Mechanic.FullName</td>
                                               
                                            </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <br />
                            @Html.PagedListPager(Model.StaticDiagnosePagedList, page => Url.Action("Index", new
                                {
                                    page,
                                    keyword = ViewBag.Keyword,
                                    fromDate = ViewBag.FromDate.ToString("yyyy-MM-dd"),
                                    toDate = ViewBag.ToDate.ToString("yyyy-MM-dd"),
                                    VehicleId = ViewBag.VehicleId,
                                    municipality = ViewBag.Municipality,
                                    region = ViewBag.Region,
                                    agentId = ViewBag.AgentId,
                                    keywordType = (int?)ViewBag.KeywordType,
                                    sortBy = ViewBag.SortBy,
                                    sortOrder = ViewBag.SortOrder
                                }), new X.PagedList.Mvc.Core.PagedListRenderOptions
                           {
                               DisplayItemSliceAndTotal = false,
                               ContainerDivClasses = new[] { "pagination-container" },
                               LiElementClasses = new[] { "page-item" },
                               PageClasses = new[] { "page-link" },
                               DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
                               DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always
                           })
 
                            <div class="card-footer d-flex justify-content-between align-items-baseline">
                                <div>
                                    <i class="fas fa-database"></i> <strong>Total kontrolla:</strong> @Model.StaticDiagnosePagedList.TotalItemCount;
                                </div>
                                <div>
                                @{
                                    var totalCost = Model.TotalCost;
                                }
                                    <i class="fas fa-euro-sign"></i> <strong>Total cmimi:</strong> €@totalCost.ToString("N2")
                                </div>
                                <div>
                                @{
                                    var totalPayed = Model.TotalPayed;
                                }
                                    <span class="text-success">  <i class="fas fa-euro-sign"></i> <strong>Paguara:</strong> €@totalPayed.ToString("N2") </span>
                                </div>
                                <div>
                                @{
                                    var totalUnPayed = Model.TotalUnPayed;
                                }
                                    <span class="text-danger">    <i class="fas fa-euro-sign"></i> <strong>Pa Paguara:</strong> €@totalUnPayed.ToString("N2") </span>
                                </div>
                            </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>