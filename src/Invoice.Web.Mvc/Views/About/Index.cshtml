@using Invoice.Web.Startup
@{
    ViewBag.CurrentPageName = PageNames.About;
    ViewBag.Title = L("About");
}
<div class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <h1 class="m-0 text-dark">@L("About")</h1>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                       

                        <h3> D.P.Z "Meritoni"</h3>

                        <p>
                            D.P.Z "Meritoni" është një qendër profesionale për servisim dhe mirëmbajtje të veturave, me një përvojë të gjatë mbi 15 vjet në industrinë automobilistike.  </p>
                         <p>  
                             E themeluar me përkushtim dhe pasion për veturat, servisi ynë ka ndërtuar një reputacion të fortë për cilësi, besueshmëri dhe korrektësi. </p>
                         <p>   
                             Specialiteti ynë është ekspertiza në veturat Mercedes-Benz – duke filluar nga modelet klasike deri tek ato më të reja, ne kuptojmë teknologjinë, mekanikën dhe specifikat e këtij brendi të njohur gjerman. Me një staf të kualifikuar dhe pajisje moderne diagnostifikuese, 
                             garantojmë zgjidhje të shpejta dhe të sakta për çdo problem teknik. </p>

                            <p>Që nga fillimi, qëllimi ynë ka qenë të ofrojmë shërbime të nivelit të lartë, duke ndërtuar një marrëdhënie të qëndrueshme dhe të ndershme me çdo klient.
                                Çdo veturë që vjen tek ne trajtohet me kujdes maksimal, njësoj si të ishte prona jonë personale. </p>

                         <p> <b>   Ju mirëpresim në D.P.Z "Meritoni", aty ku përvoja dhe profesionalizmi takohen për t’i dhënë veturës suaj shërbimin që meriton! </b>
                        </p>

                      
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
