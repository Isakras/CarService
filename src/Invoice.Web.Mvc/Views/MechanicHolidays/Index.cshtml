@using Abp.Application.Services.Dto;
@using Invoice.MechanicHolidays.Dto;
@using Invoice.Web.Startup;
@using Invoice.Web.Models.Common;
@using X.PagedList;
@using X.PagedList.Mvc.Core;
@using X.PagedList.Web.Common;
@model X.PagedList.IPagedList<Invoice.MechanicHolidays.Dto.MechanicHolidayDto>
@{
    ViewBag.Title = L("Holidays");
    ViewBag.CurrentPageName = PageNames.MechanicHolidays;
}

@section scripts
{
    <script src="~/view-resources/Views/MechanicHolidays/Index.js" asp-append-version="true"></script>
}
<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Pushimet e Punëtorëve</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-start mb-3">

                            <div class="col-12 col-md-3 mb-2">
                                <label>&nbsp;</label>
                                <br />
                            <button type="button"
                                    class="btn btn-primary text-white border-0"
                                    id="btnCreateHoliday">
                                + Cakto Pushimin
                            </button>
                           </div>

                            <div id="CreateHolidayModalContainer"></div>

                        @* 
                            <div class="col-12 col-md-3 mb-2">
                                <label>&nbsp;</label>
                                <br />
                                <button type="button"
                                        class="btn btn-primary text-white border-0 text-uppercase"
                                        data-toggle="modal"
                                        data-target="#MechanicCreateModal"
                                        id="btnCreateHoliday">
                                    + Pushime të Reja
                                </button>
                            </div> *@
                            <div class="col-12 col-md-9">
                                @await Html.PartialAsync("~/Views/VehiclesDiagnosis/Index.AdvancedSearch.cshtml")
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">

                            <table id="WorkerHolidayTsble" class="table table-striped table-bordered table-sm text-wrap">
                                <thead style="background-color: #4ab6be; color: white;">
                                    <tr>
                                        <th style="width: 80px;">@L("Actions")</th>
                                        <th style="width: 130px;">Emri</th>
                                        <th style="width: 130px;">Data Fillimit</th>
                                        <th style="width: 170px;">Data Perfundimit</th>
                                        <th style="width: 170px;">Ditet ne Pushim</th>
                                        <th style="width: 170px;">Komenti</th>
                               
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info">Detajet</a>
                                            </td>
                                            <td title="@item.Mechanic.FullName">@item.Mechanic.FullName</td>
                                            <td title="@item.StartDate.ToString("yyyy-MM-dd")">@item.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td title="@item.EndDate.ToString("yyyy-MM-dd")">@item.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td title="@item.NumberOfDays">@item.NumberOfDays</td>
                                            <td title="@item.Comment">@item.Comment</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <br />
                        @Html.PagedListPager(Model, page => Url.Action("Index", new
                            {
                                page,
                                keyword = ViewBag.Keyword,
                                fromDate = ViewBag.FromDate.ToString("yyyy-MM-dd"),
                                toDate = ViewBag.ToDate.ToString("yyyy-MM-dd"),
                                WorkerId = ViewBag.WorkerId

                        }), new X.PagedList.Mvc.Core.PagedListRenderOptions
                   {
                       DisplayItemSliceAndTotal = false,
                       ContainerDivClasses = new[] { "pagination-container" },
                       LiElementClasses = new[] { "page-item" },
                       PageClasses = new[] { "page-link" },
                       DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
                       DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always
                   })

                        <div class="card-footer d-flex justify-content-between align-items-baseline">
                            <div>
                                <i class="fas fa-database"></i> <strong>Total Ditet:</strong> @Model.TotalItemCount;
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
@*     @await Html.PartialAsync("_CreateHolidayModal") *@
</section>
