@using Abp.Authorization.Users
@using Invoice.Web.Models.Common.Modals
@using Invoice.Workers
@using Invoice.Web.Models.Mechanic
@model Invoice.Web.Models.MechanicHolidays.CreateMechanicHolidayViewModel

@{
    Layout = null;
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#WorkerSelect').change(function () {
                var selectedWorkerId = $(this).val();
                $('#MechanicId').val(selectedWorkerId);
            });
        });
    </script>
}

<div class="modal fade" id="MechanicCreateModal" tabindex="-1" role="dialog" aria-labelledby="VehicleCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Cakto Pushimi për Puëtorin"))
            <form name="mechanicCreateForm" role="form" class="form-horizontal">
                <div class="modal-body">

                    <div class="form-group row required">
                        <label for="WorkerSelect" class="col-md-3 col-form-label">Punëtori</label>
                        <div class="col-md-9">
                            <select id="WorkerSelect" class="form-control">
                                <option value="">-- Zgjedh Punëtorin --</option>
                                @foreach (var worker in Model.Workers)
                                {
                                    <option value="@worker.Id">@worker.FullName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <input type="hidden" id="MechanicId" name="MechanicId"  value=""/>

                   @*  <div class="form-group row required">
                        <label for="WorkkerId" class="col-md-3 col-form-label">Data e Fillimit</label> 
                        <div class="col-md-9">
                       
                           <input type="hidden" id="WorkkerId" class="form-control" name="WorkkerId" required>
                        </div>
                    </div> *@

                 

                    <div class="form-group row required">
                        <label for="StartDate" class="col-md-3 col-form-label">Data e Fillimit</label>
                        <div class="col-md-9">
                            <input type="date" id="StartDate" class="form-control" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label for="EdnDate" class="col-md-3 col-form-label">Data e Përfundimit</label>
                        <div class="col-md-9">
                            <input type="date" id="EdnDate" class="form-control" name="EdnDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label for="Days" class="col-md-3 col-form-label">Ditët në Pushim</label>
                        <div class="col-md-9">
                            <input type="number" id="NumberOfDays" class="form-control" name="NumberOfDays">
                        </div>
                    </div>
                  

                    <div class="form-group row ">
                        <label for="Comment" class="col-md-3 col-form-label">Comment</label>
                        <div class="col-md-9">
                            <input type="text" id="Comment" class="form-control" name="Comment">
                        </div>
                    </div>

                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>